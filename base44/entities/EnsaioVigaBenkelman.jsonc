{
  "name": "EnsaioVigaBenkelman",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "project_id": {
      "type": "string",
      "description": "ID do Projeto vinculado"
    },
    "data_ensaio": {
      "type": "string",
      "format": "date",
      "description": "Data da aplica\u00e7\u00e3o do ensaio"
    },
    "data_realizacao": {
      "type": "string",
      "format": "date",
      "description": "Data de realiza\u00e7\u00e3o do ensaio"
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do laboratorista que criou o registro"
    },
    "rodovia": {
      "type": "string",
      "description": "Nome da rodovia"
    },
    "trecho": {
      "type": "string",
      "description": "Trecho da rodovia"
    },
    "material": {
      "type": "string",
      "description": "Material analisado"
    },
    "procedencia": {
      "type": "string",
      "description": "Proced\u00eancia do material"
    },
    "pista_faixa": {
      "type": "string",
      "description": "Pista ou faixa de tr\u00e1fego"
    },
    "camada": {
      "type": "string",
      "description": "Camada analisada"
    },
    "cte_viga": {
      "type": "number",
      "description": "Coeficiente da viga (autom\u00e1tico)"
    },
    "def_admissivel": {
      "type": "number",
      "description": "Deflex\u00e3o admiss\u00edvel (x10\u207b\u00b2mm)"
    },
    "leitura_inicial_global": {
      "type": "number",
      "description": "Leitura inicial \u00fanica que ser\u00e1 replicada para todos os registros"
    },
    "levantamentos": {
      "type": "array",
      "description": "Array de levantamentos por estaca/km com medi\u00e7\u00f5es dos 3 bordos",
      "items": {
        "type": "object",
        "properties": {
          "estaca_km": {
            "type": "string",
            "description": "Estaca ou quilometragem"
          },
          "faixa_nome": {
            "type": "string",
            "description": "Nome da faixa"
          },
          "bordo_esquerdo": {
            "type": "object",
            "properties": {
              "leitura_inicial": {
                "type": "number",
                "description": "Leitura inicial (A)"
              },
              "leitura_final": {
                "type": "number",
                "description": "Leitura final (B)"
              },
              "diferenca": {
                "type": "number",
                "description": "Diferen\u00e7a (C = A - B)"
              },
              "deflexao": {
                "type": "number",
                "description": "Deflex\u00e3o (D = C \u00d7 E em x10\u207b\u00b2mm)"
              }
            }
          },
          "eixo": {
            "type": "object",
            "properties": {
              "leitura_inicial": {
                "type": "number",
                "description": "Leitura inicial (A)"
              },
              "leitura_final": {
                "type": "number",
                "description": "Leitura final (B)"
              },
              "diferenca": {
                "type": "number",
                "description": "Diferen\u00e7a (C = A - B)"
              },
              "deflexao": {
                "type": "number",
                "description": "Deflex\u00e3o (D = C \u00d7 E em x10\u207b\u00b2mm)"
              }
            }
          },
          "bordo_direito": {
            "type": "object",
            "properties": {
              "leitura_inicial": {
                "type": "number",
                "description": "Leitura inicial (A)"
              },
              "leitura_final": {
                "type": "number",
                "description": "Leitura final (B)"
              },
              "diferenca": {
                "type": "number",
                "description": "Diferen\u00e7a (C = A - B)"
              },
              "deflexao": {
                "type": "number",
                "description": "Deflex\u00e3o (D = C \u00d7 E em x10\u207b\u00b2mm)"
              }
            }
          }
        }
      }
    },
    "controle_estatistico": {
      "type": "object",
      "description": "Controle estat\u00edstico das medi\u00e7\u00f5es",
      "properties": {
        "qt_leituras": {
          "type": "number",
          "description": "Quantidade de leituras"
        },
        "media": {
          "type": "number",
          "description": "M\u00e9dia das deflex\u00f5es"
        },
        "desv_pad": {
          "type": "number",
          "description": "Desvio padr\u00e3o"
        }
      }
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho",
      "description": "Status do registro"
    },
    "approved": {
      "type": "boolean",
      "default": null,
      "description": "Status de aprova\u00e7\u00e3o"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do usu\u00e1rio que aprovou"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false
    },
    "client_signature": {
      "type": "object",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "engineer_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "obra_id",
    "data_ensaio"
  ]
}