{
  "name": "EnsaioVigaBenkelman",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "project_id": {
      "type": "string",
      "description": "ID do Projeto vinculado"
    },
    "data_ensaio": {
      "type": "string",
      "format": "date",
      "description": "Data da aplicação do ensaio"
    },
    "data_realizacao": {
      "type": "string",
      "format": "date",
      "description": "Data de realização do ensaio"
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do laboratorista que criou o registro"
    },
    "rodovia": {
      "type": "string",
      "description": "Nome da rodovia"
    },
    "trecho": {
      "type": "string",
      "description": "Trecho da rodovia"
    },
    "empreiteira": {
      "type": "string",
      "description": "Empreiteira responsável pela execução"
    },
    "material": {
      "type": "string",
      "description": "Material analisado"
    },
    "procedencia": {
      "type": "string",
      "description": "Procedência do material"
    },
    "pista_faixa": {
      "type": "string",
      "description": "Pista ou faixa de tráfego"
    },
    "camada": {
      "type": "string",
      "description": "Camada analisada"
    },
    "cte_viga": {
      "type": "number",
      "description": "Coeficiente da viga (automático)"
    },
    "def_admissivel": {
      "type": "number",
      "description": "Deflexão admissível (x10⁻²mm)"
    },
    "leitura_inicial_global": {
      "type": "number",
      "description": "Leitura inicial única que será replicada para todos os registros"
    },
    "levantamentos": {
      "type": "array",
      "description": "Array de levantamentos por estaca/km com medições dos 3 bordos",
      "items": {
        "type": "object",
        "properties": {
          "estaca_km": {
            "type": "string",
            "description": "Estaca ou quilometragem"
          },
          "faixa_nome": {
            "type": "string",
            "description": "Nome da faixa"
          },
          "bordo_esquerdo": {
            "type": "object",
            "properties": {
              "leitura_inicial": {
                "type": "number",
                "description": "Leitura inicial (A)"
              },
              "leitura_final": {
                "type": "number",
                "description": "Leitura final (B)"
              },
              "diferenca": {
                "type": "number",
                "description": "Diferença (C = A - B)"
              },
              "deflexao": {
                "type": "number",
                "description": "Deflexão (D = C × E em x10⁻²mm)"
              }
            }
          },
          "eixo": {
            "type": "object",
            "properties": {
              "leitura_inicial": {
                "type": "number",
                "description": "Leitura inicial (A)"
              },
              "leitura_final": {
                "type": "number",
                "description": "Leitura final (B)"
              },
              "diferenca": {
                "type": "number",
                "description": "Diferença (C = A - B)"
              },
              "deflexao": {
                "type": "number",
                "description": "Deflexão (D = C × E em x10⁻²mm)"
              }
            }
          },
          "bordo_direito": {
            "type": "object",
            "properties": {
              "leitura_inicial": {
                "type": "number",
                "description": "Leitura inicial (A)"
              },
              "leitura_final": {
                "type": "number",
                "description": "Leitura final (B)"
              },
              "diferenca": {
                "type": "number",
                "description": "Diferença (C = A - B)"
              },
              "deflexao": {
                "type": "number",
                "description": "Deflexão (D = C × E em x10⁻²mm)"
              }
            }
          }
        }
      }
    },
    "controle_estatistico": {
      "type": "object",
      "description": "Controle estatístico das medições",
      "properties": {
        "qt_leituras": {
          "type": "number",
          "description": "Quantidade de leituras"
        },
        "media": {
          "type": "number",
          "description": "Média das deflexões"
        },
        "desv_pad": {
          "type": "number",
          "description": "Desvio padrão"
        }
      }
    },
    "observacoes": {
      "type": "string",
      "description": "Observações gerais"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho",
      "description": "Status do registro"
    },
    "approved": {
      "type": "boolean",
      "default": null,
      "description": "Status de aprovação"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do usuário que aprovou"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false
    },
    "client_signature": {
      "type": "object",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "engineer_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "obra_id",
    "data_ensaio"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        },
        { "user_condition": { "access_level": "cliente" } },
        { "user_condition": { "access_level": "cliente_supervisor" } },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}
