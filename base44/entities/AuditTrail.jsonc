{
  "name": "AuditTrail",
  "type": "object",
  "properties": {
    "entity_name": {
      "type": "string",
      "description": "Nome da entidade auditada (ex: EnsaioCAUQ, ChecklistTerraplanagem, User, AuthSession)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID do registro auditado"
    },
    "operation": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "approve",
        "reject",
        "sign",
        "approve_nc",
        "reject_nc",
        "solicitar_aprovacao_nc",
        "update_nc_status",
        "login_success",
        "login_failure",
        "logout",
        "logout_inactivity",
        "password_reset_request",
        "password_reset",
        "report_exported",
        "permission_updated",
        "user_created",
        "user_deactivated",
        "token_expired"
      ],
      "description": "Tipo de evento auditado (category + action)"
    },
    "changes": {
      "type": "array",
      "description": "Lista de campos alterados com valores anterior e novo",
      "items": {
        "type": "object"
      }
    },
    "changed_by": {
      "type": "string",
      "description": "Email do usuario que executou a acao"
    },
    "changed_by_name": {
      "type": "string",
      "description": "Nome do usuario que executou a acao"
    },
    "actor_role": {
      "type": "string",
      "description": "Papel/nivel de acesso do usuario no momento da acao (ex: admin, gestor_contrato, user)"
    },
    "client_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp do cliente (quando editado offline)"
    },
    "is_offline_sync": {
      "type": "boolean",
      "default": false,
      "description": "Se a alteracao foi sincronizada de uma edicao offline"
    },
    "ip_address": {
      "type": "string",
      "description": "Endereco IP de origem da solicitacao (considera X-Forwarded-For)"
    },
    "device_info": {
      "type": "string",
      "description": "User-Agent do navegador ou identificador do dispositivo mobile"
    },
    "result": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ],
      "default": "success",
      "description": "Resultado da acao: success ou failure"
    },
    "failure_reason": {
      "type": "string",
      "description": "Motivo do fracasso (quando result = failure)"
    },
    "chain_hash": {
      "type": "string",
      "description": "Hash SHA-256 do conteudo desta entrada + hash da entrada anterior (cadeia tamper-evident)"
    },
    "previous_hash": {
      "type": "string",
      "description": "Hash da entrada anterior na cadeia (null para a primeira entrada)"
    }
  },
  "required": [
    "entity_name",
    "operation"
  ],
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "__append_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__append_only__"
      }
    }
  }
}