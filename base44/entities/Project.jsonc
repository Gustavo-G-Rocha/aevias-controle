{
  "name": "Project",
  "type": "object",
  "properties": {
    "tipo_projeto": {
      "type": "string",
      "enum": [
        "CAUQ",
        "MRAF",
        "BGS",
        "CARTA_TRACO_CONCRETO",
        "CAMADAS_GRANULARES"
      ],
      "default": "CAUQ",
      "description": "Tipo do projeto"
    },
    "regional_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo",
        "pausado"
      ],
      "default": "ativo"
    },
    "faixa_granulometrica_id": {
      "type": "string"
    },
    "equivalente_areia_minimo": {
      "type": "number"
    },
    "agregados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "pedreira": {
            "type": "string"
          },
          "percentual_mistura": {
            "type": "number"
          },
          "granulometria": {
            "type": "object"
          }
        }
      }
    },
    "ligante": {
      "type": "object",
      "properties": {
        "tipo": {
          "type": "string"
        },
        "fornecedor": {
          "type": "string"
        },
        "densidade": {
          "type": "number"
        }
      }
    },
    "emulsao_utilizada": {
      "type": "string"
    },
    "temperaturas": {
      "type": "object",
      "properties": {
        "mistura": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "compactacao": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "espalhamento": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      }
    },
    "faixa_trabalho": {
      "type": "object"
    },
    "faixa_trabalho_min": {
      "type": "object"
    },
    "faixa_trabalho_max": {
      "type": "object"
    },
    "teor_ligante": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "otimo": {
          "type": "number"
        }
      }
    },
    "teor_ligante_residual": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "otimo": {
          "type": "number"
        }
      }
    },
    "percentual_emulsao": {
      "type": "number"
    },
    "taxa_aplicacao_mraf": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "otimo": {
          "type": "number"
        }
      }
    },
    "densidade_mistura_mraf": {
      "type": "number"
    },
    "massa_especifica_aparente": {
      "type": "number"
    },
    "densidade_maxima_medida": {
      "type": "number"
    },
    "relacao_filer_betume": {
      "type": "number",
      "description": "Rela\u00e7\u00e3o F\u00edler/Betume de projeto (%)"
    },
    "volume_vazios": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "otimo": {
          "type": "number"
        }
      }
    },
    "rtcd": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        }
      }
    },
    "estabilidade": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "projeto": {
          "type": "number"
        }
      }
    },
    "fluencia": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "projeto": {
          "type": "number"
        }
      }
    },
    "vam": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "projeto": {
          "type": "number"
        }
      }
    },
    "rbv": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "projeto": {
          "type": "number"
        }
      }
    },
    "fck": {
      "type": "number"
    },
    "slump_projeto": {
      "type": "number"
    },
    "slump_minimo": {
      "type": "number"
    },
    "slump_maximo": {
      "type": "number"
    },
    "consumo_agua": {
      "type": "number"
    },
    "tipo_aditivo": {
      "type": "string"
    },
    "tipo_cimento": {
      "type": "string"
    },
    "concreteira": {
      "type": "string"
    },
    "melhorador_utilizado": {
      "type": "string"
    },
    "umidade_otima": {
      "type": "number",
      "description": "Umidade \u00f3tima (%) - BGS e Camadas Granulares"
    },
    "densidade_otima": {
      "type": "number"
    },
    "resistencia_mpa": {
      "type": "number"
    },
    "densidade_seca_max": {
      "type": "number",
      "description": "Densidade seca m\u00e1xima (g/cm\u00b3) - apenas BGS"
    },
    "faixa_trabalho_bgs": {
      "type": "object",
      "description": "Faixa de trabalho BGS (min/max por peneira)",
      "properties": {
        "faixa_min_75": {
          "type": "number"
        },
        "faixa_max_75": {
          "type": "number"
        },
        "faixa_min_50": {
          "type": "number"
        },
        "faixa_max_50": {
          "type": "number"
        },
        "faixa_min_38": {
          "type": "number"
        },
        "faixa_max_38": {
          "type": "number"
        },
        "faixa_min_25": {
          "type": "number"
        },
        "faixa_max_25": {
          "type": "number"
        },
        "faixa_min_19": {
          "type": "number"
        },
        "faixa_max_19": {
          "type": "number"
        },
        "faixa_min_9_5": {
          "type": "number"
        },
        "faixa_max_9_5": {
          "type": "number"
        },
        "faixa_min_4_75": {
          "type": "number"
        },
        "faixa_max_4_75": {
          "type": "number"
        },
        "faixa_min_2_0": {
          "type": "number"
        },
        "faixa_max_2_0": {
          "type": "number"
        },
        "faixa_min_0_42": {
          "type": "number"
        },
        "faixa_max_0_42": {
          "type": "number"
        },
        "faixa_min_0_075": {
          "type": "number"
        },
        "faixa_max_0_075": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "name",
    "client",
    "tipo_projeto"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        },
        {
          "user_condition": {
            "data.access_level": "cliente"
          }
        },
        {
          "user_condition": {
            "data.access_level": "cliente_supervisor"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}