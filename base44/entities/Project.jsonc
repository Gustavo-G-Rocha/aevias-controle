    "name",
    "client",
    "tipo_projeto"
  ],
  "rls": {
    "read": {},
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    }
