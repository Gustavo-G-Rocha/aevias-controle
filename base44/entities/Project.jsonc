{
  "name": "Project",
  "type": "object",
  "properties": {
    "tipo_projeto": {
      "type": "string",
      "enum": [
        "CAUQ",
        "MRAF",
        "BGS",
        "CARTA_TRACO_CONCRETO",
        "CAMADAS_GRANULARES"
      ],
      "default": "CAUQ",
      "description": "Tipo do projeto: CAUQ, MRAF, BGS, Carta Tra\u00e7o de Concreto ou Camadas Granulares"
    },
    "regional_id": {
      "type": "string",
      "description": "ID da regional a qual este projeto est\u00e1 vinculado"
    },
    "name": {
      "type": "string",
      "description": "Nome do projeto"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do projeto"
    },
    "client": {
      "type": "string",
      "description": "Cliente do projeto"
    },
    "location": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o do projeto"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo",
        "pausado"
      ],
      "default": "ativo"
    },
    "faixa_granulometrica_id": {
      "type": "string",
      "description": "ID da Faixa Granulom\u00e9trica de refer\u00eancia - apenas para CAUQ, MRAF, BGS, CAMADAS_GRANULARES"
    },
    "equivalente_areia_minimo": {
      "type": "number",
      "description": "Limite m\u00ednimo de equivalente de areia (%) - apenas para CAUQ, MRAF, BGS"
    },
    "agregados": {
