          "type": "string",
          "enum": [
            "Sim",
            "Não"
          ]
        },
        "filtro_conforme": {
          "type": "string",
          "enum": [
            "Sim",
            "Não"
          ]
        },
        "dosador_finos_retornados": {
          "type": "string",
          "enum": [
            "Sim",
            "Não"
          ]
        },
        "dosador_filler": {
          "type": "string"
        },
        "sistema_destorroamento_rap": {
          "type": "string",
          "enum": [
            "Sim",
            "Não"
          ]
        },
        "classificacao_rap_fracoes": {
          "type": "string",
          "enum": [
            "Sim",
            "Não"
          ]
        },
        "operacao": {
          "type": "string"
        },
        "projeto_wma": {
          "type": "string",
          "enum": [
            "Sim",
            "Não"
          ]
        },
        "utiliza_cal": {
          "type": "string",
          "enum": [
            "Sim",
            "Não"
          ]
        },
        "utiliza_rap": {
          "type": "string",
          "enum": [
            "Sim",
            "Não"
          ]
        },
        "silo_especifico_rap": {
          "type": "string",
          "enum": [
            "Sim",
            "Não"
          ]
        },
        "sistema_dosagem_rap": {
          "type": "string",
          "enum": [
            "Sim",
            "Não"
          ]
        },
        "percentual_rap": {
          "type": "number"
        }
      }
    },
    "ensaios_validacao": {
      "type": "object",
      "description": "Seção 7.2 - Ensaios para validação"
    },
    "resultado_classe": {
      "type": "string",
      "enum": [
        "Classe I",
        "Classe II",
        "Classe III"
      ]
    },
    "observacoes_resultado": {
      "type": "string"
    },
    "observacoes_gerais": {
      "type": "string"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das fotos da vistoria"
    },
    "laboratorista_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho"
    },
    "approved": {
      "type": [
        "boolean",
        "null"
      ],
      "default": null
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object"
    },
    "rejection_reason": {
      "type": "string"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false
    },
    "client_signature": {
      "type": "object"
    }
  },
  "required": [
    "obra_id",
    "data_vistoria"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": { "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": { "data.access_level": "gestor_contrato"
          }
        },
        { "user_condition": { "data.access_level": "cliente" } },
        { "user_condition": { "data.access_level": "cliente_supervisor" } },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": { "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": { "data.access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": { "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": { "data.access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}
