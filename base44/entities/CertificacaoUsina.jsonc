              "type": "string",
              "enum": [
                "Sim",
                "Não"
              ]
            }
          }
        }
      }
    },
    "laboratorio": {
      "type": "object",
      "description": "Seção 7.1 - Laboratório"
    },
    "afeicao": {
      "type": "object",
      "description": "Seção 7.2 - Aferição, repetibilidade e reprodutibilidade"
    },
    "estrutura_fisica": {
      "type": "object",
      "description": "Seção 7.3 - Estrutura e espaço físico"
    },
    "usina_asfalto": {
      "type": "object",
      "description": "Seção 7.4 - Usina de asfalto",
      "properties": {
        "tipo": {
