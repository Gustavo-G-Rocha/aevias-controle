          "type": "number"
        },
        "fonte_eletrica": {
          "type": "string"
        },
        "observacoes_fonte": {
          "type": "string"
        },
        "producao_nominal": {
          "type": "number"
        },
        "umidade_pct": {
          "type": "number"
        },
        "altitude_m": {
          "type": "number"
        },
        "material_retido_n8": {
          "type": "number"
        },
        "temperatura_final_massa": {
          "type": "number"
        },
        "producao_efetiva": {
          "type": "number"
        },
