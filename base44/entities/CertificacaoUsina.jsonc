{
  "name": "CertificacaoUsina",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "razao_social": {
      "type": "string"
    },
    "interessado": {
      "type": "string"
    },
    "responsavel_tecnico": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "data_vistoria": {
      "type": "string",
      "format": "date"
    },
    "avaliador": {
      "type": "string"
    },
    "cnpj": {
      "type": "string"
    },
    "validade": {
      "type": "string",
      "format": "date"
    },
    "localizacao": {
      "type": "string"
    },
    "marca_usina": {
      "type": "string"
    },
    "numero_serie": {
      "type": "string"
    },
    "fornecimento_agregado": {
      "type": "string"
    },
    "mineralogia": {
      "type": "string"
    },
    "classe_usina": {
      "type": "string",
      "enum": [
        "Classe I",
        "Classe II",
        "Classe III"
      ]
    },
    "tipo_dosagem": {
      "type": "string",
      "enum": [
        "Descont\u00ednua",
        "Cont\u00ednua"
      ]
    },
    "tipo_secagem": {
      "type": "string",
      "enum": [
        "Fluxo paralelo",
        "Contra fluxo"
      ]
    },
    "aspectos_legais": {
      "type": "object",
      "properties": {
        "autorizacao_ambiental": {
          "type": "string",
          "enum": [
            "Sim",
            "N\u00e3o"
          ]
        },
        "licenca_previa": {
          "type": "string",
          "enum": [
            "Sim",
            "N\u00e3o"
          ]
        },
        "licenca_instalacao": {
          "type": "string",
          "enum": [
            "Sim",
            "N\u00e3o"
          ]
        },
        "licenca_operacao": {
          "type": "string",
          "enum": [
            "Sim",
            "N\u00e3o"
          ]
        }
      }
    },
    "saude_seguranca": {
      "type": "object",
      "description": "Se\u00e7\u00e3o 5 - Aspectos de sa\u00fade e seguran\u00e7a"
    },
    "meio_ambiente": {
      "type": "object",
      "description": "Se\u00e7\u00e3o 6 - Meio Ambiente"
    },
    "laboratorio": {
      "type": "object",
      "description": "Se\u00e7\u00e3o 7.1 - Laborat\u00f3rio"
    },
    "afeicao": {
      "type": "object",
      "description": "Se\u00e7\u00e3o 7.2 - Aferi\u00e7\u00e3o, repetibilidade e reprodutibilidade"
    },
    "estrutura_fisica": {
      "type": "object",
      "description": "Se\u00e7\u00e3o 7.3 - Estrutura e espa\u00e7o f\u00edsico"
    },
    "usina_asfalto": {
      "type": "object",
      "description": "Se\u00e7\u00e3o 7.4 - Usina de asfalto"
    },
    "ensaios_validacao": {
      "type": "object",
      "description": "Se\u00e7\u00e3o 7.2 - Ensaios para valida\u00e7\u00e3o"
    },
    "resultado_classe": {
      "type": "string",
      "enum": [
        "Classe I",
        "Classe II",
        "Classe III"
      ]
    },
    "observacoes_resultado": {
      "type": "string"
    },
    "observacoes_gerais": {
      "type": "string"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das fotos da vistoria"
    },
    "laboratorista_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho"
    },
    "approved": {
      "type": [
        "boolean",
        "null"
      ],
      "default": null
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object"
    },
    "rejection_reason": {
      "type": "string"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false
    },
    "client_signature": {
      "type": "object"
    }
  },
  "required": [
    "obra_id",
    "data_vistoria"
  ],
  "rls": {
    "read": {},
    "write": {}
  }
}