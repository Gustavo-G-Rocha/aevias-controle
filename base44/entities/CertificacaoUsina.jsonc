{
  "name": "CertificacaoUsina",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "razao_social": {
      "type": "string"
    },
    "interessado": {
      "type": "string"
    },
    "responsavel_tecnico": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "data_vistoria": {
      "type": "string",
      "format": "date"
    },
    "avaliador": {
      "type": "string"
    },
    "cnpj": {
      "type": "string"
    },
    "validade": {
      "type": "string",
      "format": "date"
    },
