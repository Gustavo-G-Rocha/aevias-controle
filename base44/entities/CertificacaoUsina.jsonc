        "Classe II",
        "Classe III"
      ]
    },
    "tipo_dosagem": {
      "type": "string",
      "enum": [
        "Descontínua",
        "Contínua"
      ]
    },
    "tipo_secagem": {
      "type": "string",
      "enum": [
        "Fluxo paralelo",
        "Contra fluxo"
      ]
    },
