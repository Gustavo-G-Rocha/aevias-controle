{
  "name": "EnsaioTaxaPinturaImprimacao",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "data_ensaio": {
      "type": "string",
      "format": "date",
      "description": "Data do ensaio"
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do laboratorista que criou o registro"
    },
    "engenheiro_responsavel": {
      "type": "string",
      "description": "Nome do engenheiro responsável"
    },
    "rodovia": {
      "type": "string",
      "description": "Nome da rodovia"
    },
    "trecho": {
      "type": "string",
      "description": "Descrição do trecho"
    },
    "material": {
      "type": "string",
      "description": "Material utilizado"
    },
    "placa_caminhao": {
      "type": "string",
      "description": "Placa do caminhão"
    },
    "tipo_servico": {
      "type": "string",
      "enum": [
        "imprimacao",
        "ligacao"
      ],
      "description": "Tipo de serviço: Imprimação ou Ligação"
    },
    "dimensoes_bandeja": {
      "type": "object",
      "description": "Dimensões globais da bandeja (aplicadas a todos os ensaios)",
      "properties": {
        "lado_1": {
          "type": "number",
          "description": "Lado 1 da bandeja (cm)"
        },
        "lado_2": {
          "type": "number",
          "description": "Lado 2 da bandeja (cm)"
        },
        "area": {
          "type": "number",
          "description": "Área calculada (m²)"
        }
      }
    },
    "ensaios": {
      "type": "array",
      "description": "Array de ensaios (até 4)",
      "items": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "number",
            "description": "Número do ensaio"
          },
          "hora": {
            "type": "string",
            "description": "Hora de realização do ensaio"
          },
          "camada": {
            "type": "string",
            "description": "Camada de aplicação"
          },
          "material_camada": {
            "type": "string",
            "description": "Material da camada"
          },
          "estaca": {
            "type": "string",
            "description": "Estaca do ensaio"
          },
          "temperatura_aplicacao": {
            "type": "number",
            "description": "Temperatura de aplicação do ligante (°C)"
          },
          "peso_bandeja_amostra": {
            "type": "number",
            "description": "Peso da bandeja + amostra (g)"
          },
          "peso_bandeja": {
            "type": "number",
            "description": "Peso da bandeja (g)"
          },
          "peso_emulsao": {
            "type": "number",
            "description": "Peso da emulsão calculado (g)"
          },
          "taxa_aplicada": {
            "type": "number",
            "description": "Taxa aplicada calculada (l/m²)"
          },
          "taxa_emulsao_aplicada": {
            "type": "number",
            "description": "Taxa de emulsão aplicada calculada (l/m²)"
          },
          "taxa_residual": {
            "type": "number",
            "description": "Taxa residual calculada (l/m²)"
          },
          "ensaio_residuo": {
            "type": "object",
            "description": "Dados do ensaio de resíduo",
            "properties": {
              "data": {
                "type": "string",
                "format": "date",
                "description": "Data do ensaio de resíduo"
              },
              "tara": {
                "type": "number",
                "description": "Tara (g)"
              },
              "peso_inicial": {
                "type": "number",
                "description": "Peso inicial (g)"
              },
              "peso_final": {
                "type": "number",
                "description": "Peso final (g)"
              },
              "residuo": {
                "type": "number",
                "description": "Resíduo calculado (%)"
              }
            }
          }
        }
      }
    },
    "observacoes": {
      "type": "string",
      "description": "Observações gerais"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho",
      "description": "Status do registro: rascunho (em edição) ou finalizado (pronto para revisão)"
    },
    "approved": {
      "type": "boolean",
      "default": null,
      "description": "Status de aprovação"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do usuário que aprovou/reprovou"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "client_signature": {
      "type": "object",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "engineer_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "obra_id",
    "data_ensaio"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        },
        {
          "user_condition": {
            "data.access_level": "user"
          }
        },
        {
          "user_condition": {
            "data.access_level": "funcionarios_cliente"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}
