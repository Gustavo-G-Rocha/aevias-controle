{
  "name": "ControleExecucaoServicos",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do controle"
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do inspetor que criou o registro"
    },
    "rodovia": {
      "type": "string",
      "description": "Nome da rodovia"
    },
    "trecho": {
      "type": "string",
      "description": "Trecho"
    },
    "servicos": {
      "type": "array",
      "description": "Serviços realizados",
      "items": {
        "type": "object",
        "properties": {
          "servico": {
            "type": "string",
            "description": "Descrição do serviço"
          },
          "estaca_inicial": {
            "type": "string"
          },
          "estaca_final": {
            "type": "string"
          },
          "comprimento_m": {
            "type": [
              "number",
              "null"
            ],
            "description": "Comprimento (m)"
          },
          "espessura_cm": {
            "type": [
              "number",
              "null"
            ],
            "description": "Espessura (cm)"
          },
          "largura_m": {
            "type": [
              "number",
              "null"
            ],
            "description": "Largura (m)"
          },
          "quantidade": {
            "type": [
              "number",
              "null"
            ]
          },
          "executora": {
            "type": "string",
            "description": "Empresa executora"
          }
        }
      }
    },
    "fotos": {
      "type": "array",
      "description": "Registro fotográfico (URL ou objeto com legenda)",
      "items": {
        "type": [
          "string",
          "object"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "legenda": {
            "type": "string"
          }
        }
      }
    },
    "observacoes_gerais": {
      "type": "string",
      "description": "Observações gerais"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho",
      "description": "Status do registro"
    },
    "approved": {
      "type": "boolean",
      "default": null,
      "description": "Status de aprovação"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do usuário que aprovou/reprovou"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o registro foi reprovado e editado novamente"
    },
    "client_signature": {
      "type": "object",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "engineer_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "obra_id",
    "data"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        },
        {
          "user_condition": {
            "data.access_level": "user"
          }
        },
        {
          "user_condition": {
            "data.access_level": "funcionarios_cliente"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}
