{
  "name": "FaixaGranulometrica",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "CAUQ",
        "MRAF",
        "BGS",
        "CAMADAS_GRANULARES"
      ],
      "description": "Tipo da faixa: CAUQ, MRAF, BGS ou Camadas Granulares"
    },
    "nome": {
      "type": "string",
      "description": "Nome da faixa granulométrica"
    },
    "especificacao": {
      "type": "string",
      "description": "Especificação técnica"
    },
    "orgao": {
      "type": "string",
      "description": "Órgão responsável pela especificação"
    },
    "peneiras": {
      "type": "array",
      "description": "Lista de peneiras com seus limites",
      "items": {
        "type": "object",
        "properties": {
          "astm": {
            "type": "string",
            "description": "Referência ASTM da peneira (ex: 3/8\", Nº 4, etc.)"
          },
          "abertura": {
            "type": "string",
            "description": "Abertura da peneira em mm (gerada automaticamente)"
          },
          "min": {
            "type": "number",
            "description": "Percentual mínimo passante"
          },
          "max": {
            "type": "number",
            "description": "Percentual máximo passante"
          }
        },
        "required": [
          "astm",
          "abertura",
          "min",
          "max"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "default": "ativo",
      "description": "Status da faixa granulométrica"
    }
  },
  "required": [
    "tipo",
    "nome",
    "especificacao",
    "orgao",
    "peneiras"
  ],
  "rls": {
    "read": {},
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        }
      ]
    }
  }
}
