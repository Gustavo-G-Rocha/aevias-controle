{
  "name": "EnsaioSondagem",
  "type": "object",
  "properties": {
    "metodo_ensaio": {
      "type": "string",
      "enum": [
        "DNIT 428/2022",
        "DNER 117/94"
      ],
      "default": "DNIT 428/2022",
      "description": "Método de ensaio utilizado"
    },
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "project_id": {
      "type": "string",
      "description": "ID do Projeto vinculado"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do ensaio"
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do laboratorista que criou o registro"
    },
    "usina_fornecedora": {
      "type": "string",
      "description": "Nome da usina fornecedora"
    },
    "servico": {
      "type": "string",
      "description": "Tipo de serviço"
    },
    "rodovia": {
      "type": "string",
      "description": "Nome da rodovia"
    },
    "trecho": {
      "type": "string",
      "description": "Descrição do trecho"
    },
    "fator_correcao_prensa": {
      "type": "number",
      "description": "Fator de correção da prensa",
      "default": 1
    },
    "dens_agua_25c": {
      "type": "number",
      "description": "Densidade da água a 25°C (g/cm³)",
      "default": 0.9971
    },
    "volume_vazios_projeto": {
      "type": "number",
      "description": "Volume de vazios de projeto (%)"
    },
    "dens_aparente_projeto": {
      "type": "number",
      "description": "Densidade aparente de projeto (g/cm³)"
    },
    "dens_rice_projeto": {
      "type": "number",
      "description": "Densidade RICE de projeto (g/cm³)"
    },
    "espessura_projeto": {
      "type": "number",
      "description": "Espessura de projeto (cm)"
    },
    "corpos_prova": {
      "type": "array",
      "description": "Array de corpos de prova (até 20)",
      "items": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "number"
          },
          "data_execucao": {
            "type": "string",
            "format": "date"
          },
          "estaca": {
            "type": "string"
          },
          "lado": {
            "type": "string",
            "enum": [
              "direito",
              "esquerdo"
            ]
          },
          "medidas_espessura": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Até 4 medidas de espessura"
          },
          "media_espessura": {
            "type": "number"
          },
          "peso_ao_ar": {
            "type": "number",
            "description": "Peso ao ar (g)"
          },
          "peso_imerso": {
            "type": "number",
            "description": "Peso imerso (g)"
          },
          "peso_saturado": {
            "type": "number",
            "description": "Peso saturado (g)"
          },
          "volume": {
            "type": "number",
            "description": "Volume (cm³)"
          },
          "densidade": {
            "type": "number",
            "description": "Densidade (g/cm³)"
          },
          "gc_dens_projeto": {
            "type": "number",
            "description": "G.C. Dens. Projeto (%)"
          },
          "dens_rice_do_dia": {
            "type": "number",
            "description": "Dens. RICE do dia (g/cm³)"
          },
          "gc_dens_rice_dia": {
            "type": "number",
            "description": "G.C. Dens. RICE do dia (%)"
          },
          "volume_vazios": {
            "type": "number",
            "description": "Volume de vazios (%)"
          },
          "leitura": {
            "type": "number",
            "description": "Leitura (Kgf/cm²)"
          },
          "rtcd_25c": {
            "type": "number",
            "description": "RTCD a 25°C (MPa)"
          }
        }
      }
    },
    "observacoes": {
      "type": "string",
      "description": "Observações gerais"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho",
      "description": "Status do registro: rascunho (em edição) ou finalizado (pronto para revisão)"
    },
    "approved": {
      "type": "boolean",
      "default": null,
      "description": "Status de aprovação"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do usuário que aprovou/reprovou"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o registro foi reprovado e editado novamente"
    },
    "client_signature": {
      "type": "object",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "engineer_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "obra_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": { "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": { "data.access_level": "gestor_contrato"
          }
        },
        { "user_condition": { "data.access_level": "cliente" } },
        { "user_condition": { "data.access_level": "cliente_supervisor" } },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": { "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": { "data.access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": { "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": { "data.access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}
