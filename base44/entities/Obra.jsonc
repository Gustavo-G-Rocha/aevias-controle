{
  "name": "Obra",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da obra"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo da obra/contrato"
    },
    "regional_id": {
      "type": "string",
      "description": "ID da regional a que pertence a obra (herda projetos, cliente e equipe da regional)"
    },
    "tipo_obra": {
      "type": "string",
      "enum": [
        "supervisao",
        "gerenciamento",
        "implantacao",
        "conservacao",
        "sondagem",
        "levantamentos",
        "homologacao_usinas"
      ],
      "description": "Tipo de obra: Supervis\u00e3o, Gerenciamento, Implanta\u00e7\u00e3o, Conserva\u00e7\u00e3o, Sondagem, Levantamentos ou Homologa\u00e7\u00e3o de Usinas"
    },
    "status": {
      "type": "string",
      "enum": [
        "planejamento",
        "em_andamento",
        "concluida",
        "pausada"
      ],
      "default": "planejamento",
      "description": "Status da obra"
    },
    "empreiteiras": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nomes das empreiteiras do contrato - apenas para obras de Supervis\u00e3o e Gerenciamento"
    },
    "clientes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nomes dos clientes - apenas para obras de Levantamentos e Sondagem"
    },
    "usinas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nomes das usinas que atendem o contrato"
    },
    "rodovias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nomes das rodovias da obra/contrato"
    },
    "servicos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Servi\u00e7os do contrato - apenas para obras de Gerenciamento"
    }
  },
  "required": [
    "name",
    "code",
    "regional_id",
    "tipo_obra"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "$or": [
          {
            "role": "admin"
          },
          {
            "data.access_level": "sala_tecnica_afirmaevias"
          },
          {
            "data.access_level": "gestor_contrato"
          }
        ]
      }
    },
    "read": {
      "user_condition": {
        "$or": [
          {
            "role": "admin"
          },
          {
            "data.access_level": "sala_tecnica_afirmaevias"
          },
          {
            "data.access_level": "gestor_contrato"
          },
          {
            "data.access_level": "cliente"
          },
          {
            "data.access_level": "cliente_supervisor"
          },
          {
            "data.access_level": "user"
          }
        ]
      }
    },
    "update": {
      "user_condition": {
        "$or": [
          {
            "role": "admin"
          },
          {
            "data.access_level": "sala_tecnica_afirmaevias"
          },
          {
            "data.access_level": "gestor_contrato"
          }
        ]
      }
    },
    "delete": {
      "user_condition": {
        "$or": [
          {
            "role": "admin"
          },
          {
            "data.access_level": "sala_tecnica_afirmaevias"
          },
          {
            "data.access_level": "gestor_contrato"
          }
        ]
      }
    }
  }
}