{
  "name": "EnsaioDensidadeInSitu",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "project_id": {
      "type": "string",
      "description": "ID do Projeto vinculado"
    },
    "data_ensaio": {
      "type": "string",
      "format": "date",
      "description": "Data do ensaio"
    },
    "horario": {
      "type": "string",
      "description": "Horário do ensaio"
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do laboratorista que criou o registro"
    },
    "engenheiro_responsavel": {
      "type": "string",
      "description": "Nome do engenheiro responsável (Gestor de Contrato)"
    },
    "rodovia": {
      "type": "string",
      "description": "Nome da rodovia"
    },
    "trecho": {
      "type": "string",
      "description": "Descrição do trecho"
    },
    "sub_trecho": {
      "type": "string",
      "description": "Sub-trecho"
    },
    "camada": {
      "type": "string",
      "description": "Camada (ex: Subleito, Base, Sub-base)"
    },
    "material": {
      "type": "string",
      "description": "Material utilizado"
    },
    "procedencia": {
      "type": "string",
      "description": "Procedência do material"
    },
    "substituicao_retido_3_4": {
      "type": "boolean",
      "default": false,
      "description": "Ensaio com substituição do material retido na 3/4\""
    },
    "densidade_real_retida_3_4": {
      "type": "number",
      "description": "Densidade real retida 3/4\" (g/cm³) - se aplicável"
    },
    "densidade_areia": {
      "type": "number",
      "description": "Densidade da areia (g/cm³) - valor global para todos os furos"
    },
    "peso_areia_funil": {
      "type": "number",
      "description": "Peso da areia no funil (g) - valor global para todos os furos"
    },
    "dados_proctor": {
      "type": "object",
      "description": "Dados do ensaio Proctor",
      "properties": {
        "densidade_seca_max": {
          "type": "number",
          "description": "Densidade seca máxima (g/cm³)"
        },
        "umidade_otima": {
          "type": "number",
          "description": "Umidade ótima (%)"
        }
      }
    },
    "furos": {
      "type": "array",
      "description": "Array de furos realizados no ensaio",
      "items": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "number",
            "description": "Número do furo"
          },
          "estaca": {
            "type": "string",
            "description": "Estaca"
          },
          "pista": {
            "type": "string",
            "description": "Pista (ex: Direita, Esquerda)"
          },
          "profundidade_furo": {
            "type": "number",
            "description": "Profundidade do furo (cm)"
          },
          "peso_areia_garrafa_antes": {
            "type": "number",
            "description": "Peso da areia + garrafa antes do ensaio (g)"
          },
          "peso_areia_garrafa_apos": {
            "type": "number",
            "description": "Peso da areia + garrafa após o ensaio (g)"
          },
          "peso_material_umido_furo": {
            "type": "number",
            "description": "Peso do material úmido no furo (g)"
          },
          "peso_solo_retido_3_4_umido": {
            "type": "number",
            "description": "Peso do solo retido 3/4\" úmido no furo (g) - se aplicável"
          },
          "tara_frigideira": {
            "type": "number",
            "description": "Tara da frigideira (g)"
          },
          "material_umido_frigideira": {
            "type": "number",
            "description": "Material úmido + frigideira (g)"
          },
          "material_seco_frigideira": {
            "type": "number",
            "description": "Material seco + frigideira (g)"
          },
          "densidade_umida_furo": {
            "type": "number",
            "description": "Densidade úmida do furo (g/cm³) - calculado"
          },
          "densidade_seca_solo": {
            "type": "number",
            "description": "Densidade seca do solo (g/cm³) - calculado"
          },
          "umidade": {
            "type": "number",
            "description": "Umidade (%) - calculado"
          },
          "desvio_umidade": {
            "type": "number",
            "description": "Desvio de umidade (%) - calculado"
          },
          "grau_compactacao": {
            "type": "number",
            "description": "Grau de compactação (%) - calculado"
          }
        }
      }
    },
    "observacoes": {
      "type": "string",
      "description": "Observações gerais"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das fotos"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho",
      "description": "Status do registro: rascunho (em edição) ou finalizado (pronto para revisão)"
    },
    "approved": {
      "type": "boolean",
      "default": null,
      "description": "Status de aprovação"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do usuário que aprovou/reprovou"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false
    },
    "client_signature": {
      "type": "object",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "engineer_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "obra_id",
    "data_ensaio"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        },
        {
          "user_condition": {
            "data.access_level": "user"
          }
        },
        {
          "user_condition": {
            "data.access_level": "funcionarios_cliente"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}
