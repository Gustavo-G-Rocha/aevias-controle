{
  "name": "AcompanhamentoCarga",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "project_id": {
      "type": "string",
      "description": "ID do Projeto vinculado"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do acompanhamento"
    },
    "jornada": {
      "type": "object",
      "description": "Jornada de trabalho do funcionário",
      "properties": {
        "horario_inicio": {
          "type": "string",
          "description": "Horário de início do turno (HH:mm)"
        },
        "horario_fim": {
          "type": "string",
          "description": "Horário de fim do turno (HH:mm)"
        }
      }
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do laboratorista que criou o registro"
    },
    "rodovia": {
      "type": "string",
      "description": "Nome da rodovia"
    },
    "trecho": {
      "type": "string",
      "description": "Trecho"
    },
    "sub_trecho": {
      "type": "string",
      "description": "Sub-trecho"
    },
    "usina_fornecedora": {
      "type": "string",
      "description": "Nome da usina fornecedora"
    },
    "servico": {
      "type": "string",
      "enum": [
        "remendos",
        "capa_reperfilagem"
      ],
      "description": "Tipo de serviço: Remendos ou Capa/Reperfilagem"
    },
    "cargas": {
      "type": "array",
      "description": "Array de cargas (até 20)",
      "items": {
        "type": "object",
        "properties": {
          "numero_carga": {
            "type": "number"
          },
          "placa": {
            "type": "string"
          },
          "hora_saida": {
            "type": "string"
          },
          "peso_toneladas": {
            "type": "number"
          },
          "hora_chegada": {
            "type": "string"
          },
          "temp_chegada": {
            "type": "number"
          },
          "hora_aplicacao": {
            "type": "string"
          },
          "temp_espalhamento": {
            "type": "number"
          },
          "temp_compactacao": {
            "type": "number"
          },
          "pista": {
            "type": "string"
          },
          "espessura_cm": {
            "type": "number"
          },
          "estaca_inicial": {
            "type": "string"
          },
          "estaca_final": {
            "type": "string"
          },
          "observacoes": {
            "type": "string"
          }
        }
      }
    },
    "observacoes_gerais": {
      "type": "string",
      "description": "Observações gerais"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho",
      "description": "Status do registro: rascunho (em edição) ou finalizado (pronto para revisão)"
    },
    "approved": {
      "type": "boolean",
      "default": null,
      "description": "Status de aprovação"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do usuário que aprovou/reprovou"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o registro foi reprovado e editado novamente"
    },
    "client_signature": {
      "type": "object",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "engineer_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "obra_id",
    "data"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        },
        {
          "user_condition": {
            "access_level": "cliente"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}
