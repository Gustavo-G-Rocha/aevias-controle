{
  "name": "AcompanhamentoUsinagem",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "project_id": {
      "type": "string",
      "description": "ID do Projeto vinculado"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do acompanhamento"
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do laboratorista que criou o registro"
    },
    "trecho": {
      "type": "string",
      "description": "Descrição do trecho"
    },
    "pedreira": {
      "type": "string",
      "description": "Nome da pedreira"
    },
    "numero_projeto": {
      "type": "string",
      "description": "Número do projeto"
    },
    "faixa_especificada": {
      "type": "string",
      "description": "Faixa granulométrica especificada"
    },
    "rodovia": {
      "type": "string",
      "description": "Nome da rodovia"
    },
    "usina": {
      "type": "string",
      "description": "Nome da usina"
    },
    "ligante_nome": {
      "type": "string",
      "description": "Nome do ligante"
    },
    "temperatura_ligante": {
      "type": [
        "number",
        "null"
      ],
      "description": "Temperatura do ligante (CAP) em °C"
    },
    "agregados": {
      "type": "array",
      "description": "Lista de agregados",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "description": "Nome do agregado"
          },
          "composicao": {
            "type": [
              "number",
              "null"
            ],
            "description": "Composição em %"
          },
          "umidade": {
            "type": [
              "number",
              "null"
            ],
            "description": "Umidade em %"
          },
          "temperatura_t1": {
            "type": [
              "number",
              "null"
            ],
            "description": "Temperatura T1 em °C"
          },
          "temperatura_t2": {
            "type": [
              "number",
              "null"
            ],
            "description": "Temperatura T2 em °C"
          }
        }
      }
    },
    "cargas": {
      "type": "array",
      "description": "Lista de cargas acompanhadas",
      "items": {
        "type": "object",
        "properties": {
          "placa_caminhao": {
            "type": "string"
          },
          "hora_saida": {
            "type": "string"
          },
          "peso": {
            "type": [
              "number",
              "null"
            ],
            "description": "Peso em toneladas"
          },
          "temperatura_1": {
            "type": [
              "number",
              "null"
            ],
            "description": "Temperatura em °C"
          },
          "temperatura_2": {
            "type": [
              "number",
              "null"
            ],
            "description": "Temperatura em °C"
          },
          "observacao": {
            "type": "string"
          }
        }
      }
    },
    "observacoes_gerais": {
      "type": "string",
      "description": "Observações gerais"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho",
      "description": "Status do registro"
    },
    "approved": {
      "type": [
        "boolean",
        "null"
      ],
      "default": null,
      "description": "Status de aprovação"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do usuário que aprovou/reprovou"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false
    },
    "client_signature": {
      "type": "object",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "engineer_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "obra_id",
    "data"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        },
        { "user_condition": { "access_level": "cliente" } },
        { "user_condition": { "access_level": "cliente_supervisor" } },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}
