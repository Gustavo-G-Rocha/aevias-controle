{
  "name": "EnsaioRompimentoConcreto",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "project_id": {
      "type": "string",
      "description": "ID do Projeto (Carta Traço de Concreto)"
    },
    "data_ensaio": {
      "type": "string",
      "format": "date",
      "description": "Data do ensaio"
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do laboratorista"
    },
    "cliente": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "rodovia": {
      "type": "string",
      "description": "Rodovia"
    },
    "volume_betonado": {
      "type": "number",
      "description": "Volume betonado (m³)"
    },
    "fornecedor": {
      "type": "string",
      "description": "Fornecedor/Concreteira"
    },
    "hora_moldagem": {
      "type": "string",
      "description": "Hora da moldagem"
    },
    "trecho": {
      "type": "string",
      "description": "Trecho"
    },
    "projeto_trac": {
      "type": "string",
      "description": "Projeto/Traço"
    },
    "numero_moldagem": {
      "type": "string",
      "description": "Número de moldagem"
    },
    "estrutura": {
      "type": "string",
      "description": "Estrutura"
    },
    "construtora": {
      "type": "string",
      "description": "Construtora"
    },
    "nota_fiscal": {
      "type": "string",
      "description": "Nota fiscal"
    },
    "estaca_moldagem": {
      "type": "string",
      "description": "Estaca de moldagem"
    },
    "slump_test": {
      "type": "number",
      "description": "Slump test (mm)"
    },
    "temperatura_ambiente": {
      "type": "number",
      "description": "Temperatura ambiente (°C)"
    },
    "hora_saida_usina": {
      "type": "string",
      "description": "Hora de saída da usina"
    },
    "hora_chegada_campo": {
      "type": "string",
      "description": "Hora de chegada no campo"
    },
    "compressao_axial": {
      "type": "array",
      "description": "Dados de resistência à compressão axial",
      "items": {
        "type": "object",
        "properties": {
          "numero_cp": {
            "type": "string",
            "description": "Número do corpo de prova"
          },
          "idade": {
            "type": "number",
            "description": "Idade (dias)"
          },
          "dimensao": {
            "type": "string",
            "enum": [
              "5x10",
              "15x30",
              "10x20"
            ],
            "description": "Dimensão do CP"
          },
          "data_ruptura": {
            "type": "string",
            "format": "date",
            "description": "Data da ruptura"
          },
          "carga_ruptura": {
            "type": "number",
            "description": "Carga de ruptura (tf)"
          },
          "area_cp": {
            "type": "number",
            "description": "Área do corpo de prova (cm²)"
          },
          "resistencia": {
            "type": "number",
            "description": "Resistência (MPa)"
          }
        }
      }
    },
    "tracao_flexao": {
      "type": "array",
      "description": "Dados de resistência à tração na flexão",
      "items": {
        "type": "object",
        "properties": {
          "numero_cp": {
            "type": "string",
            "description": "Número do corpo de prova"
          },
          "ponto_ruptura": {
            "type": "string",
            "enum": [
              "No terço médio",
              "Fora do terço médio"
            ],
            "description": "Ponto de ruptura do CP"
          },
          "idade": {
            "type": "number",
            "description": "Idade (dias)"
          },
          "data_ruptura": {
            "type": "string",
            "format": "date",
            "description": "Data da ruptura"
          },
          "carga_ruptura": {
            "type": "number",
            "description": "Carga de ruptura (kgf)"
          },
          "vao_central": {
            "type": "number",
            "description": "Vão central do CP (mm)"
          },
          "altura_cp": {
            "type": "number",
            "description": "Altura do CP (mm)"
          },
          "largura_cp": {
            "type": "number",
            "description": "Largura do CP (mm)"
          },
          "resistencia": {
            "type": "number",
            "description": "Resistência (MPa)"
          }
        }
      }
    },
    "observacoes": {
      "type": "string",
      "description": "Observações"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho",
      "description": "Status do registro"
    },
    "approved": {
      "type": [
        "boolean",
        "null"
      ],
      "default": null,
      "description": "Status de aprovação"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do usuário que aprovou"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object"
    },
    "rejection_reason": {
      "type": "string"
    },
    "client_signature": {
      "type": "object"
    }
  },
  "required": [
    "obra_id",
    "data_ensaio"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        },
        {
          "user_condition": {
            "data.access_level": "user"
          }
        },
        {
          "user_condition": {
            "data.access_level": "funcionarios_cliente"
          }
        }
      ]
    },
        "read": {
      "$or": [
        { "data.status": { "$ne": "rascunho" } },
        { "created_by": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}
