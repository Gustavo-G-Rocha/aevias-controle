{
  "name": "EnsaioManchaPendulo",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "data_ensaio": {
      "type": "string",
      "format": "date",
      "description": "Data do ensaio"
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do laboratorista"
    },
    "rodovia": {
      "type": "string",
      "description": "Nome da rodovia"
    },
    "trecho": {
      "type": "string",
      "description": "Descrição do trecho"
    },
    "empreiteira": {
      "type": "string",
      "description": "Empreiteira responsável pela execução"
    },
    "camada": {
      "type": "string",
      "description": "Camada"
    },
    "pista": {
      "type": "string",
      "description": "Pista"
    },
    "orgao": {
      "type": "string",
      "enum": [
        "DER/PR",
        "DNIT",
        "ECO-RODOVIAS"
      ],
      "description": "Orgao de especificação"
    },
    "ensaios_mancha": {
      "type": "array",
      "description": "Ensaios de Mancha de Areia (até 15)",
      "items": {
        "type": "object"
      }
    },
    "ensaios_pendulo": {
      "type": "array",
      "description": "Ensaios de Pêndulo Britânico (até 15)",
      "items": {
        "type": "object"
      }
    },
    "limites_mancha": {
      "type": "string",
      "description": "Limites estabelecidos para Mancha de Areia",
      "default": "0,6mm ≤ HS ≤ 1,2mm"
    },
    "limites_pendulo": {
      "type": "string",
      "description": "Limites estabelecidos para Pêndulo Britânico",
      "default": "VRD ≥ 47"
    },
    "condicao_conformidade": {
      "type": "string",
      "enum": [
        "CONFORME",
        "NÃO CONFORME"
      ],
      "description": "Condição de conformidade geral"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações gerais"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho",
      "description": "Status do registro"
    },
    "approved": {
      "type": "boolean",
      "default": null,
      "description": "Status de aprovação"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do usuário que aprovou/reprovou"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o registro foi reprovado e editado novamente"
    },
    "client_signature": {
      "type": "object",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "engineer_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "obra_id",
    "data_ensaio"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        },
        { "user_condition": { "access_level": "cliente" } },
        { "user_condition": { "access_level": "cliente_supervisor" } },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}
