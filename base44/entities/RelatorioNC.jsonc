{
  "name": "RelatorioNC",
  "type": "object",
  "properties": {
    "numero_rnc": {
      "type": "string",
      "description": "Número do RNC"
    },
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "obra_nome": {
      "type": "string",
      "description": "Nome da obra (copiado no momento da criação)"
    },
    "cliente": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "rodovia": {
      "type": "string",
      "description": "Rodovia"
    },
    "trecho": {
      "type": "string",
      "description": "Trecho"
    },
    "fiscal": {
      "type": "string",
      "description": "Nome do fiscal"
    },
    "data_nc": {
      "type": "string",
      "format": "date",
      "description": "Data da NC"
    },
    "campo": {
      "type": "string",
      "description": "Campo (equipe Afirma Evias - preenchido pelo checklist ou digitado)"
    },
    "relatorio_criador": {
      "type": "string",
      "description": "Nome do gestor criador do relatório (automático)"
    },
    "executora": {
      "type": "string",
      "description": "Nome da executora"
    },
    "contrato": {
      "type": "string",
      "description": "Número do contrato"
    },
    "descricao_nc": {
      "type": "string",
      "description": "Descrição da não conformidade"
    },
    "acoes": {
      "type": "string",
      "description": "Ações a serem tomadas"
    },
    "local_nc": {
      "type": "string",
      "enum": [
        "CAMPO",
        "USINA"
      ],
      "description": "Local da NC: Campo ou Usina"
    },
    "categoria_nc": {
      "type": "string",
      "description": "Categoria da NC"
    },
    "parametro_nc": {
      "type": "string",
      "description": "Parâmetro da NC"
    },
    "checklist_ref_tipo": {
      "type": "string",
      "description": "Tipo do checklist de referência"
    },
    "checklist_ref_id": {
      "type": "string",
      "description": "ID do checklist de referência"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das fotos anexadas pelo gestor"
    },
    "pdfs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          }
        }
      },
      "description": "URLs dos PDFs anexados pelo gestor"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberta",
        "em_tratativa",
        "encerrada",
        "cancelada"
      ],
      "default": "aberta",
      "description": "Status da NC"
    },
    "pendente_aprovacao_cliente": {
      "type": "boolean",
      "default": false,
      "description": "Indica se a NC está aguardando aprovação do cliente antes de mudar status"
    },
    "cliente_aprovacao": {
      "type": "string",
      "enum": [
        "aprovada",
        "reprovada"
      ],
      "description": "Aprovação do cliente: aprovada ou reprovada"
    },
    "cliente_aprovacao_data": {
      "type": "string",
      "format": "date-time",
      "description": "Data da aprovação/reprovação do cliente"
    },
    "cliente_aprovacao_responsavel": {
      "type": "string",
      "description": "Email do cliente que aprovou/reprovou"
    },
    "cliente_reprovacao_motivo": {
      "type": "string",
      "description": "Motivo da reprovação pelo cliente"
    },
    "manager_signature": {
      "type": "object",
      "description": "Assinatura automática do gestor ao criar o relatório",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "manager_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "client_signature": {
      "type": "object",
      "description": "Assinatura do engenheiro cliente",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "engineer_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "obra_id",
    "data_nc",
    "descricao_nc"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        },
        { "user_condition": { "access_level": "cliente" } },
        { "user_condition": { "access_level": "cliente_supervisor" } },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}
