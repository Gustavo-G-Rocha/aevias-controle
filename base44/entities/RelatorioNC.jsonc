{
  "name": "RelatorioNC",
  "type": "object",
  "properties": {
    "numero_rnc": {
      "type": "string",
      "description": "N\u00famero do RNC"
    },
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "obra_nome": {
      "type": "string",
      "description": "Nome da obra (copiado no momento da cria\u00e7\u00e3o)"
    },
    "cliente": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "rodovia": {
      "type": "string",
      "description": "Rodovia"
    },
    "trecho": {
      "type": "string",
      "description": "Trecho"
    },
    "fiscal": {
      "type": "string",
      "description": "Nome do fiscal"
    },
    "data_nc": {
      "type": "string",
      "format": "date",
      "description": "Data da NC"
    },
    "campo": {
      "type": "string",
      "description": "Campo (equipe Afirma Evias - preenchido pelo checklist ou digitado)"
    },
    "relatorio_criador": {
      "type": "string",
      "description": "Nome do gestor criador do relat\u00f3rio (autom\u00e1tico)"
    },
    "executora": {
      "type": "string",
      "description": "Nome da executora"
    },
    "contrato": {
      "type": "string",
      "description": "N\u00famero do contrato"
    },
    "descricao_nc": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da n\u00e3o conformidade"
    },
    "acoes": {
      "type": "string",
      "description": "A\u00e7\u00f5es a serem tomadas"
    },
    "local_nc": {
      "type": "string",
      "enum": [
        "CAMPO",
        "USINA"
      ],
      "description": "Local da NC: Campo ou Usina"
    },
    "categoria_nc": {
      "type": "string",
      "description": "Categoria da NC"
    },
    "parametro_nc": {
      "type": "string",
      "description": "Par\u00e2metro da NC"
    },
    "checklist_ref_tipo": {
      "type": "string",
      "description": "Tipo do checklist de refer\u00eancia"
    },
    "checklist_ref_id": {
      "type": "string",
      "description": "ID do checklist de refer\u00eancia"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das fotos anexadas pelo gestor"
    },
    "pdfs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          }
        }
      },
      "description": "URLs dos PDFs anexados pelo gestor"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberta",
        "em_tratativa",
        "encerrada",
        "cancelada"
      ],
      "default": "aberta",
      "description": "Status da NC"
    },
    "pendente_aprovacao_cliente": {
      "type": "boolean",
      "default": false,
      "description": "Indica se a NC est\u00e1 aguardando aprova\u00e7\u00e3o do cliente antes de mudar status"
    },
    "cliente_aprovacao": {
      "type": "string",
      "enum": [
        "aprovada",
        "reprovada"
      ],
      "description": "Aprova\u00e7\u00e3o do cliente: aprovada ou reprovada"
    },
    "cliente_aprovacao_data": {
      "type": "string",
      "format": "date-time",
      "description": "Data da aprova\u00e7\u00e3o/reprova\u00e7\u00e3o do cliente"
    },
    "cliente_aprovacao_responsavel": {
      "type": "string",
      "description": "Email do cliente que aprovou/reprovou"
    },
    "cliente_reprovacao_motivo": {
      "type": "string",
      "description": "Motivo da reprova\u00e7\u00e3o pelo cliente"
    },
    "manager_signature": {
      "type": "object",
      "description": "Assinatura autom\u00e1tica do gestor ao criar o relat\u00f3rio",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "manager_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "client_signature": {
      "type": "object",
      "description": "Assinatura do engenheiro cliente",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "engineer_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "obra_id",
    "data_nc",
    "descricao_nc"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}