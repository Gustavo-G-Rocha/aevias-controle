{
  "name": "DiarioObra",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "cliente": {
      "type": "string",
      "description": "Nome do cliente (copiado da regional no momento da criação)"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do diário"
    },
    "jornada": {
      "type": "object",
      "description": "Jornada de trabalho do funcionário",
      "properties": {
        "horario_inicio": {
          "type": "string",
          "description": "Horário de início do turno (HH:mm)"
        },
        "horario_fim": {
          "type": "string",
          "description": "Horário de fim do turno (HH:mm)"
        }
      }
    },
    "tipo_local": {
      "type": "string",
      "enum": [
        "usina",
        "campo"
      ],
      "description": "Tipo de local: usina ou campo"
    },
    "empreiteira": {
      "type": "string",
      "description": "Nome da empreiteira"
    },
    "usina_selecionada": {
      "type": "string",
      "description": "Nome da usina (quando tipo_local = usina)"
    },
    "rodovia": {
      "type": "string",
      "description": "Nome da rodovia (quando tipo_local = campo)"
    },
    "trecho": {
      "type": "string",
      "description": "Descrição do trecho (quando tipo_local = campo)"
    },
    "condicoes_climaticas": {
      "type": "string",
      "enum": [
        "ensolarado",
        "nublado",
        "chuvoso",
        "garoa",
        "vento_forte",
        "neblina"
      ],
      "description": "Condições climáticas do dia"
    },
    "temperatura": {
      "type": [
        "number",
        "null"
      ],
      "description": "Temperatura ambiente (°C)"
    },
    "atividades_realizadas": {
      "type": "string",
      "description": "Descrição das atividades realizadas no dia"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações gerais do dia"
    },
    "acoes_corretivas_realizado": {
      "type": [
        "boolean",
        "null"
      ],
      "default": null,
      "description": "Se foram realizadas ações corretivas"
    },
    "acoes_corretivas_descricao": {
      "type": "string",
      "description": "Descrição das ações corretivas realizadas"
    },
    "nao_conformidades": {
      "type": "array",
      "description": "Lista de não conformidades identificadas",
      "items": {
        "type": "object",
        "properties": {
          "local_nc": {
            "type": "string",
            "description": "Local da NC: CAMPO ou USINA"
          },
          "categoria_nc": {
            "type": "string",
            "description": "Categoria da NC"
          },
          "parametro_nc": {
            "type": "string",
            "description": "Parâmetro da NC"
          },
          "descricao": {
            "type": "string",
            "description": "Descrição detalhada da NC"
          }
        }
      }
    },
    "efetivo_obra_ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se o efetivo de obra deve ser preenchido"
    },
    "efetivo_maquinas": {
      "type": "object",
      "description": "Efetivo de máquinas operantes",
      "properties": {
        "motoniveladora": {
          "type": "number"
        },
        "pa_carregadeira": {
          "type": "number"
        },
        "retroescavadeira": {
          "type": "number"
        },
        "escavadeira_hidraulica": {
          "type": "number"
        },
        "mini_carregadeira": {
          "type": "number"
        },
        "extrusora": {
          "type": "number"
        },
        "caminhao_prancha": {
          "type": "number"
        },
        "caminhao_munck": {
          "type": "number"
        },
        "caminhao_sinalizacao": {
          "type": "number"
        },
        "caminhao_pipa": {
          "type": "number"
        },
        "caminhao_basculante": {
          "type": "number"
        },
        "caminhao_cimento": {
          "type": "number"
        },
        "caminhao_viga": {
          "type": "number"
        },
        "caminhao_espargidor": {
          "type": "number"
        },
        "recicladora": {
          "type": "number"
        },
        "vibro_acabadora": {
          "type": "number"
        },
        "rolo_carneiro": {
          "type": "number"
        },
        "rolo_liso": {
          "type": "number"
        },
        "rolo_pneu": {
          "type": "number"
        },
        "tanque_combustivel": {
          "type": "number"
        },
        "comboio": {
          "type": "number"
        },
        "onibus": {
          "type": "number"
        },
        "trator_grade": {
          "type": "number"
        },
        "trator_esteira": {
          "type": "number"
        },
        "veiculo_leve": {
          "type": "number"
        },
        "placa_vibratoria": {
          "type": "number"
        }
      }
    },
    "efetivo_colaboradores": {
      "type": "object",
      "description": "Efetivo de colaboradores",
      "properties": {
        "encarregado": {
          "type": "number"
        },
        "greidista": {
          "type": "number"
        },
        "operadores": {
          "type": "number"
        },
        "motorista": {
          "type": "number"
        },
        "pedreiro": {
          "type": "number"
        },
        "armador": {
          "type": "number"
        },
        "carpinteiro": {
          "type": "number"
        },
        "ajudante": {
          "type": "number"
        },
        "topografo": {
          "type": "number"
        },
        "aux_topografia": {
          "type": "number"
        },
        "laboratorista": {
          "type": "number"
        },
        "aux_laboratorio": {
          "type": "number"
        },
        "spoter": {
          "type": "number"
        },
        "seguranca": {
          "type": "number"
        },
        "apontador": {
          "type": "number"
        },
        "pintor": {
          "type": "number"
        },
        "eletricista": {
          "type": "number"
        }
      }
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das fotos do diário de obra"
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do laboratorista que criou o registro"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho",
      "description": "Status do registro: rascunho (em edição) ou finalizado (pronto para revisão)"
    },
    "approved": {
      "type": "boolean",
      "default": null,
      "description": "Status de aprovação: true (aprovado), false (reprovado), null (pendente)"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do usuário que aprovou/reprovou"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da aprovação/reprovação"
    },
    "approver_details": {
      "type": "object",
      "description": "Detalhes de quem aprovou",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "rejection_reason": {
      "type": "string",
      "description": "Motivo da reprovação (quando applicable)"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o registro foi reprovado e editado novamente"
    },
    "client_signature": {
      "type": "object",
      "description": "Assinatura do cliente engenheiro",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "engineer_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "checklist_veiculo_ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se o checklist de veículo deve ser preenchido"
    },
    "checklist_veiculo": {
      "type": "object",
      "description": "Dados do checklist de veículo de passeio",
      "properties": {
        "nome_condutor": {
          "type": "string"
        },
        "tipo_veiculo": {
          "type": "string",
          "enum": [
            "passeio",
            "picape"
          ],
          "default": "passeio"
        },
        "veiculo": {
          "type": "string"
        },
        "placa": {
          "type": "string"
        },
        "empresa": {
          "type": "string"
        },
        "hodometro": {
          "type": "string"
        },
        "areas_afetadas": {
          "type": "string"
        },
        "condicoes_gerais": {
          "type": "object",
          "properties": {
            "limpeza_externa": {
              "type": "string",
              "enum": [
                "bom",
                "medio",
                "ruim"
              ]
            },
            "limpeza_interna": {
              "type": "string",
              "enum": [
                "bom",
                "medio",
                "ruim"
              ]
            },
            "pneus": {
              "type": "string",
