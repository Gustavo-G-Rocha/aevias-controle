                  ]
                },
                "luz_freio": {
                  "type": "string",
                  "enum": [
                    "sim",
                    "nao",
                    "na"
                  ]
                },
                "seta": {
                  "type": "string",
                  "enum": [
                    "sim",
                    "nao",
                    "na"
                  ]
                }
              }
            },
            "esquerda": {
              "type": "object",
              "properties": {
                "luz": {
                  "type": "string",
                  "enum": [
                    "sim",
                    "nao",
                    "na"
                  ]
                },
                "luz_re": {
                  "type": "string",
