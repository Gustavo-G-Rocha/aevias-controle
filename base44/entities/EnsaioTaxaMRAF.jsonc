{
  "name": "EnsaioTaxaMRAF",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "data_ensaio": {
      "type": "string",
      "format": "date",
      "description": "Data do ensaio"
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do laboratorista"
    },
    "rodovia": {
      "type": "string",
      "description": "Rodovia"
    },
    "trecho": {
      "type": "string",
      "description": "Trecho"
    },
    "placa_caminhao": {
      "type": "string",
      "description": "Placa do caminhão espargidor"
    },
    "material": {
      "type": "string",
      "description": "Material utilizado"
    },
    "numero_projeto": {
      "type": "string",
      "description": "Número do projeto"
    },
    "dimensoes_bandeja": {
      "type": "object",
      "description": "Dimensões globais da bandeja",
      "properties": {
        "lado_1": {
          "type": "number",
          "description": "Lado 1 (cm)"
        },
        "lado_2": {
          "type": "number",
          "description": "Lado 2 (cm)"
        },
        "area": {
          "type": "number",
          "description": "Área calculada (m²)"
        }
      }
    },
    "ensaios": {
      "type": "array",
      "description": "Ensaios individuais (até 4)",
      "items": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "number"
          },
          "estaca": {
            "type": "string",
            "description": "Estaca do ensaio"
          },
          "posicao": {
            "type": "string",
            "description": "Posição"
          },
          "peso_bandeja_amostra": {
            "type": "number",
            "description": "Peso bandeja+amostra P1 (g)"
          },
          "peso_bandeja": {
            "type": "number",
            "description": "Peso da bandeja P2 (g)"
          },
          "peso_amostra": {
            "type": "number",
            "description": "Peso da amostra PA=P1-P2 (g)"
          },
          "taxa_mraf_aplicada": {
            "type": "number",
            "description": "Taxa de MRAF aplicada Tx (kg/m²)"
          },
          "teor_ligante": {
            "type": "number",
            "description": "Teor de ligante L do ensaio de extração (%)"
          },
          "taxa_ligante": {
            "type": "number",
            "description": "Taxa de ligante TL (L/m²)"
          },
          "residuo_emulsao": {
            "type": "number",
            "description": "Resíduo da emulsão R (%)"
          },
          "taxa_emulsao": {
            "type": "number",
            "description": "Taxa de emulsão TE=TL/R (L/m²)"
          },
          "taxa_agregado": {
            "type": "number",
            "description": "Taxa de agregado TA=Tx-TL (kg/m²)"
          }
        }
      }
    },
    "media_taxa_emulsao": {
      "type": "number",
      "description": "Média da taxa de emulsão (L/m²)"
    },
    "media_taxa_agregado": {
      "type": "number",
      "description": "Média da taxa de agregado (kg/m²)"
    },
    "media_taxa_mraf": {
      "type": "number",
      "description": "Média da taxa de MRAF aplicada (kg/m²)"
    },
    "observacoes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho"
    },
    "approved": {
      "type": "boolean",
      "default": null
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false
    },
    "client_signature": {
      "type": "object",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "engineer_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "obra_id",
    "data_ensaio"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        },
        {
          "user_condition": {
            "access_level": "cliente"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}
