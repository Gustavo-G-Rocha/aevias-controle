{
  "name": "EnsaioDensidade",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "sample_id": {
      "type": "string",
      "description": "Identificação da amostra"
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do laboratorista que criou o registro"
    },
    "extraction_date": {
      "type": "string",
      "format": "date",
      "description": "Data da extração"
    },
    "location": {
      "type": "string",
      "description": "Local da extração (km, estaca, etc.)"
    },
    "pesos": {
      "type": "object",
      "description": "Pesos e medidas do corpo de prova",
      "properties": {
        "espessura_cp": {
          "type": "number",
          "description": "Espessura média do corpo de prova (mm)"
        },
        "peso_cp_seco_ar": {
          "type": "number",
          "description": "Peso do CP seco ao ar (g)"
        },
        "peso_cp_imerso_agua": {
          "type": "number",
          "description": "Peso do CP imerso em água (g)"
        },
        "peso_cp_sss": {
          "type": "number",
          "description": "Peso do CP saturado com superfície seca (g)"
        },
        "densidade_maxima_teorica": {
          "type": "number",
          "description": "Densidade máxima teórica de projeto (g/cm³)"
        },
        "fator_correcao_prensa": {
          "type": "number",
          "description": "Fator de correção da prensa",
          "default": 1
        }
      }
    },
    "observations": {
      "type": "string",
      "description": "Observações"
    },
    "approved": {
      "type": "boolean",
      "default": null,
      "description": "Se o ensaio foi aprovado"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do usuário que aprovou"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object",
      "description": "Detalhes de quem aprovou",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "client_signature": {
      "type": "object",
      "description": "Assinatura do cliente engenheiro",
      "properties": {
        "signed_by": {
          "type": "string",
          "description": "Email do cliente que assinou"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time",
          "description": "Data e hora da assinatura"
        },
        "engineer_name": {
          "type": "string",
          "description": "Nome do engenheiro que assinou"
        },
        "crea_number": {
          "type": "string",
          "description": "Número do CREA do engenheiro"
        }
      }
    }
  },
  "required": [
    "obra_id",
    "sample_id",
    "extraction_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        },
        {
          "user_condition": {
            "data.access_level": "user"
          }
        },
        {
          "user_condition": {
            "data.access_level": "funcionarios_cliente"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}
