{
  "name": "EnsaioMRAF",
  "type": "object",
  "properties": {
    "obra_id": {
      "type": "string",
      "description": "ID da obra"
    },
    "project_id": {
      "type": "string",
      "description": "ID do Projeto vinculado"
    },
    "data_ensaio": {
      "type": "string",
      "format": "date",
      "description": "Data do ensaio"
    },
    "horario": {
      "type": "string",
      "description": "Horário do ensaio"
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do laboratorista"
    },
    "placa_caminhao": {
      "type": "string",
      "description": "Placa do caminhão"
    },
    "local_coleta": {
      "type": "string",
      "description": "Local de coleta da amostra"
    },
    "pedreira": {
      "type": "string",
      "description": "Nome da pedreira"
    },
    "rodovia": {
      "type": "string",
      "description": "Nome da rodovia"
    },
    "trecho": {
      "type": "string",
      "description": "Descrição do trecho"
    },
    "tipo_ligante": {
      "type": "string",
      "description": "Tipo de ligante asfáltico"
    },
    "faixa_especificada": {
      "type": "string",
      "description": "Faixa granulométrica especificada"
    },
    "ensaio_realizado_por": {
      "type": "string",
      "enum": [
        "Afirma Evias",
        "Empreiteira"
      ],
      "default": "Afirma Evias",
      "description": "Quem realizou o ensaio"
    },
    "extracao_ligante": {
      "type": "object",
      "description": "Dados da extração de ligante (Rotarex)",
      "properties": {
        "peso_amostra": {
          "type": "number",
          "description": "Peso da amostra (g)"
        },
        "amostra_umida": {
          "type": "number",
          "description": "Amostra úmida (g)"
        },
        "amostra_seca": {
          "type": "number",
          "description": "Amostra seca (g)"
        },
        "umidade": {
          "type": "number",
          "description": "Umidade calculada (%)"
        },
        "amostra_com_ligante": {
          "type": "number",
          "description": "Amostra com ligante (g)"
        },
        "amostra_sem_ligante": {
          "type": "number",
          "description": "Amostra sem ligante (g)"
        },
        "fator_correcao": {
          "type": "number",
          "description": "Fator de correção",
          "default": 1
        },
        "peso_ligante": {
          "type": "number",
          "description": "Peso do ligante calculado (g)"
        },
        "teor_ligante": {
          "type": "number",
          "description": "Teor de ligante calculado (%)"
        },
        "residuo_emulsao": {
          "type": "number",
          "description": "Resíduo da emulsão (%)"
        },
        "percentual_emulsao": {
          "type": "number",
          "description": "Percentual de emulsão calculado (%)"
        }
      }
    },
    "granulometria": {
      "type": "object",
      "description": "Dados da granulometria",
      "properties": {
        "peso_retido_peneiras": {
          "type": "object",
          "description": "Peso retido em cada peneira",
          "properties": {
            "peneira_75_0mm": {
              "type": "number"
            },
            "peneira_63_0mm": {
              "type": "number"
            },
            "peneira_50_0mm": {
              "type": "number"
            },
            "peneira_37_5mm": {
              "type": "number"
            },
            "peneira_25_0mm": {
              "type": "number"
            },
            "peneira_19_0mm": {
              "type": "number"
            },
            "peneira_16_0mm": {
              "type": "number"
            },
            "peneira_12_5mm": {
              "type": "number"
            },
            "peneira_9_5mm": {
              "type": "number"
            },
            "peneira_4_75mm": {
              "type": "number"
            },
            "peneira_2_36mm": {
              "type": "number"
            },
            "peneira_2_0mm": {
              "type": "number"
            },
            "peneira_1_18mm": {
              "type": "number"
            },
            "peneira_0_6mm": {
              "type": "number"
            },
            "peneira_0_42mm": {
              "type": "number"
            },
            "peneira_0_3mm": {
              "type": "number"
            },
            "peneira_0_18mm": {
              "type": "number"
            },
            "peneira_0_15mm": {
              "type": "number"
            },
            "peneira_0_075mm": {
              "type": "number"
            }
          }
        }
      }
    },
    "observacoes": {
      "type": "string",
      "description": "Observações gerais"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho",
      "description": "Status do registro: rascunho (em edição) ou finalizado (pronto para revisão)"
    },
    "approved": {
      "type": "boolean",
      "default": null,
      "description": "Status de aprovação"
    },
    "approved_by": {
      "type": "string",
      "description": "Email do usuário que aprovou/reprovou"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approver_details": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    },
    "rejection_reason": {
      "type": "string"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o registro foi reprovado e editado novamente"
    },
    "client_signature": {
      "type": "object",
      "properties": {
        "signed_by": {
          "type": "string"
        },
        "signed_date": {
          "type": "string",
          "format": "date-time"
        },
        "engineer_name": {
          "type": "string"
        },
        "crea_number": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "obra_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        },
        {
          "user_condition": {
            "data.access_level": "user"
          }
        },
        {
          "user_condition": {
            "data.access_level": "funcionarios_cliente"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}
