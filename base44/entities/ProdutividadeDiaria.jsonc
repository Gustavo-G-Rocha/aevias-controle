{
  "name": "ProdutividadeDiaria",
  "type": "object",
  "properties": {
    "laboratorista_email": {
      "type": "string",
      "description": "Email do laboratorista"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do dia"
    },
    "status": {
      "type": "string",
      "enum": [
        "N/A",
        "OK"
      ],
      "description": "Status do dia: N/A (n\u00e3o aplic\u00e1vel) ou OK (servi\u00e7o extra)"
    }
  },
  "required": [
    "laboratorista_email",
    "data",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        },
        {
          "data.laboratorista_email": "{{user.email}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "data.laboratorista_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.laboratorista_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "data.access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}