{
  "name": "ProdutividadeDiaria",
  "type": "object",
  "properties": {
    "laboratorista_email": {
      "type": "string",
      "description": "Email do laboratorista"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do dia"
    },
    "status": {
      "type": "string",
      "enum": [
        "N/A",
        "OK"
      ],
      "description": "Status do dia: N/A (n\u00e3o aplic\u00e1vel) ou OK (servi\u00e7o extra)"
    }
  },
  "required": [
    "laboratorista_email",
    "data",
    "status"
  ]
}