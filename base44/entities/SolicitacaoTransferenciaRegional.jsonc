{
  "name": "SolicitacaoTransferenciaRegional",
  "type": "object",
  "properties": {
    "laboratorista_email": {
      "type": "string",
      "description": "Email do laboratorista solicitante"
    },
    "laboratorista_name": {
      "type": "string",
      "description": "Nome do laboratorista"
    },
    "regional_atual_id": {
      "type": "string",
      "description": "ID da regional atual do laboratorista"
    },
    "regional_atual_nome": {
      "type": "string",
      "description": "Nome da regional atual"
    },
    "regional_destino_id": {
      "type": "string",
      "description": "ID da regional de destino"
    },
    "regional_destino_nome": {
      "type": "string",
      "description": "Nome da regional de destino"
    },
    "motivo": {
      "type": "string",
      "description": "Motivo da solicita\u00e7\u00e3o de transfer\u00eancia"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovada",
        "rejeitada"
      ],
      "default": "pendente",
      "description": "Status da solicita\u00e7\u00e3o"
    },
    "aprovado_por": {
      "type": "string",
      "description": "Email de quem aprovou/rejeitou"
    },
    "aprovado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da aprova\u00e7\u00e3o/rejei\u00e7\u00e3o"
    },
    "motivo_rejeicao": {
      "type": "string",
      "description": "Motivo da rejei\u00e7\u00e3o (se aplic\u00e1vel)"
    }
  },
  "required": [
    "laboratorista_email",
    "laboratorista_name",
    "regional_atual_id",
    "regional_destino_id",
    "motivo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        },
        {
          "data.laboratorista_email": "{{user.email}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "data.laboratorista_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.laboratorista_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "access_level": "sala_tecnica_afirmaevias"
          }
        },
        {
          "user_condition": {
            "access_level": "gestor_contrato"
          }
        }
      ]
    }
  }
}